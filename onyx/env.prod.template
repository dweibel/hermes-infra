# Onyx Lite Production Environment Configuration
# Copy this file to .env and fill in the values before deploying.
#
# Usage:
#   cp env.prod.template .env
#   # Edit .env with your actual values
#   podman compose -f docker-compose.yml -f docker-compose.onyx-lite.yml up -d

# --- LLM Provider Settings ---
# Connects Onyx Lite to the Hermes agent API via the Podman bridge network.
# The address 10.88.0.1 is the default Podman bridge gateway, reachable from containers.
GEN_AI_API_ENDPOINT=http://10.88.0.1:8081/v1
GEN_AI_API_KEY=${HERMES_API_KEY}
GEN_AI_MODEL_VERSION=gpt-4o

# --- PostgreSQL Settings ---
POSTGRES_USER=onyx
POSTGRES_PASSWORD=onyx
POSTGRES_DB=onyx

# --- Onyx Port ---
# The Lite override (docker-compose.onyx-lite.yml) sets port 3080 externally.
# This variable is used by the base compose file; the override takes precedence.
ONYX_PORT=3080

# --- Logging ---
LOG_LEVEL=info

# --- Web Domain (optional) ---
# Set this if you want Onyx to know its public-facing URL (e.g., for CORS).
# WEB_DOMAIN=https://hermes-chat.yourdomain.com
