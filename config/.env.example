# Hermes Agent Environment Variables
# Copy this file to /mnt/workspace/hermes/.env and fill in the values.
# NEVER commit the actual .env file to version control.

# OpenRouter API key (https://openrouter.ai/keys)
# Shared credential — same key used by Goose and Hermes.
OPENROUTER_API_KEY=

# API key for the Hermes OpenAI-compatible API server (port 8081).
# Used by Onyx Lite and any other client connecting to the Hermes API.
HERMES_API_KEY=

# Shared passphrase for authenticating inbound webhook requests (port 8082).
# Must match the value configured in the Cloudflare Email Worker.
WEBHOOK_PASSPHRASE=

# Cloudflare API token scoped to Email Sending API for the target domain.
# Used by the MCP cloudflare-tools server to send outbound emails.
CF_API_TOKEN=

# Cloudflare Account ID where the domain and Email Routing are configured.
CF_ACCOUNT_ID=

# Allow all users on the web dashboard / TUI chat.
# Without this, the gateway denies all sessions (no allowlist configured).
GATEWAY_ALLOW_ALL_USERS=true

# Auto-start the web dashboard/TUI on container startup.
# The entrypoint reads this env var and launches the dashboard in the background.
# Without this, the dashboard must be started manually after each restart.
HERMES_DASHBOARD=1

# Enable the Chat tab in the web dashboard.
# Without this, the dashboard only shows sessions/config and /chat redirects to /sessions.
HERMES_DASHBOARD_TUI=1
